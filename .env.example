# Copy to .env.local and replace placeholders. Never prefix secrets with NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CASE_SESSION_SECRET=
# npm run hash:password prints hashes with \$ for Next.js .env files.
# In a hosting dashboard use npm run hash:password -- --raw (without backslashes).
CASE_DEMO_AURORA_HASH=
CASE_DEMO_ORBITA_HASH=
CASE_BLUEDESK_HASH=
CASE_ALLOWED_ORIGIN=http://localhost:3000
# Local development ONLY. Production ignores this and requires Redis REST below.
CASE_RATE_LIMIT_MODE=local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Same namespace for all instances/regions of this deployment; separate preview/production.
CASE_RATE_LIMIT_NAMESPACE=portfolio-development
