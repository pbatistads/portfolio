# Copy to .env.local and replace placeholders. Never prefix secrets with NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CASE_SESSION_SECRET=
# npm run hash:password prints hashes with \$ for Next.js .env files.
# In a hosting dashboard use npm run hash:password -- --raw (without backslashes).
CASE_BLUEDESK_HASH=
CASE_YOURH_HASH=
# Production canonical origin, HTTPS without trailing slash. Set in Vercel before build.
# Leave empty locally; Vercel can fall back to VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=
# Local development origin. Production prefers SITE_URL; do not carry localhost to hosting.
CASE_ALLOWED_ORIGIN=http://localhost:3000
# Optional exact custom Preview origin. Generated deployment/branch origins come
# from VERCEL_URL / VERCEL_BRANCH_URL, never from request Host or Origin.
CASE_PREVIEW_ORIGIN=
# Local development ONLY. Production ignores this and requires Redis REST below.
CASE_RATE_LIMIT_MODE=local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Same namespace for all instances/regions of this deployment; separate preview/production.
CASE_RATE_LIMIT_NAMESPACE=portfolio-development
# Leave blank for automatic selection: local in development, private Blob in production/preview.
# Production/Preview reject local; never use NEXT_PUBLIC_ for these settings.
CASE_MEDIA_STORAGE=
CASE_BLOB_PREFIX=cases/v1
# On Vercel, connect a PRIVATE Blob store. SDK authentication supports the
# platform-supplied BLOB_STORE_ID + VERCEL_OIDC_TOKEN (short-lived, preferred).
# Outside Vercel, supply a PRIVATE store read-write token via the environment.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN are platform-managed; do not commit values.
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL and
# VERCEL_PROJECT_PRODUCTION_URL are supplied by Vercel. Do not define them manually.
